{
  "name": "mstroy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "mstroy",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:perf": "vitest run tests/performance",
    "test:all": "vitest run",
    "test:coverage": "vitest run tests/unit --coverage"
  },
  "dependencies": {
    "ag-grid-community": "32.3.3",
    "ag-grid-enterprise": "32.3.3",
    "ag-grid-vue3": "32.3.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
